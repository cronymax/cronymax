.DS_Store
*.log

# C++
build/
out/
compile_commands.json
# CEF binary distribution — downloaded by cmake/CefDist.cmake into
# build/cef-staging/. Any cef/ at the repo root is accidental.
/cef/

# Runtime logs (the top-level `*.log` rule above only matches files,
# not directories — be explicit so `log/` doesn't show up untracked).
/log/
web/log/

# Bundled Node 26 binary — downloaded by `scripts/fetch-node26.sh`.
# Per-platform, ~200 MB per arch. The hand-written `bootstrap.js`
# sibling and any test fixtures stay tracked.
crates/cronymax/bundled/node/

# TypeScript compile outputs for the SDK + sample extensions; rebuilt
# from source via `tsc -p ...`.
sdk/*/dist/
examples/*/dist/

# Web (Vite + pnpm)
bun.lock
node_modules/
web/dist/
web/.vite/
**/tsconfig.tsbuildinfo

# Rust
/target
**/*.rs.bk

# AI
openspec/

# Per-user Claude Code overrides (settings.json is shared, *.local.json is not)
.claude/*.local.json
